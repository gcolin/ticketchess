# Reproduces the GitHub Actions CI environment (Java 25 + Maven + Playwright).
FROM maven:3.9-eclipse-temurin-25

ENV MAVEN_OPTS="-Xmx2048m"
WORKDIR /workspace

# Cache Playwright browser + OS deps (rebuilt when pom.xml changes).
# Do not use exec:java: the pom sets mainClass to Main, which starts Jetty and hangs.
COPY pom.xml .
RUN version=$(sed -n 's/.*<playwright.version>\([^<]*\)<\/playwright.version>.*/\1/p' pom.xml | head -n1) \
    && mvn -B -q org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy \
        -Dartifact="com.microsoft.playwright:playwright:${version}" \
        -DoutputDirectory=/opt/playwright \
    && java -cp "/opt/playwright/*" com.microsoft.playwright.CLI install --with-deps chromium

# Default: test job from .github/workflows/ci.yml
CMD ["mvn", "-B", "clean", "verify", "-P", "integration"]
